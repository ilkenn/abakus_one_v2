#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase Emulator local runtime data / logs (Phase 9)
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# Firebase Functions Parameters — local-only CLI/emulator overrides (Faz
# D.3.2.1, `functions/.env.local`). Never committed, per Firebase's own
# `.env.local`/`.env.*.local` convention — distinct from a project-level
# `.env.<project-id>` file (not used in this repo), which Firebase's own
# convention treats as committed, shared config, not a secret.
.env.local
.env.*.local

# Firebase Functions `defineSecret()` local override (Paket Servis P.3
# §D13, `functions/.secret.local` — holds GOOGLE_PLACES_SERVER_KEY's real
# value for local live-mode emulator testing). Distinct pattern from
# `.env.local` above — was NOT covered by it, a confirmed gap closed here
# before this secret was ever provisioned locally. Never committed.
.secret.local

# Node.js (Firestore Security Rules test harness, firestore-tests/; Cloud
# Functions source, functions/)
node_modules/
functions/lib/

# Pinned-Node-20 cache for functions/scripts/run-with-node20.sh (AP-3) — a
# downloaded runtime binary, never source; the script re-downloads it
# deterministically from nodejs.org if this directory is absent.
functions/.tools/

# Places-API coverage spike output — captured research artifacts, not source
# (functions/scripts/, Faz P.2).
functions/scripts/coverage_spike_results.json
functions/scripts/coverage_spike_followup_results.json

# Generated Blender outputs (renders/.blend/.fbx/.glb) — large binaries,
# regenerated from scripts/blender/*.py, not source.
scripts/blender/output/

# Faz P.2.1 — Google Maps SDK for iOS client key (per-machine; the
# Android equivalent lives in android/local.properties, already
# gitignored via android/.gitignore). Copy from the committed
# ApiKeys.xcconfig.example template, never commit the real file.
ios/Flutter/ApiKeys.xcconfig
